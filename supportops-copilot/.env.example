# Zendesk OAuth client (Admin Center -> Apps and integrations -> APIs -> Zendesk API -> OAuth Clients)
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_CLIENT_ID=supportops_copilot
ZENDESK_CLIENT_SECRET=changeme
ZENDESK_REDIRECT_URI=http://localhost:8000/auth/zendesk/callback
ZENDESK_SCOPES=read write

# Fernet key protecting tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Where the encrypted token blob is written.
TOKEN_STORE_PATH=./data/tokens.enc

# Ask Zendesk for an expiring access token + refresh token (seconds).
# Leave blank to request a non-expiring token. See README "Design Decisions".
ZENDESK_TOKEN_EXPIRES_IN=

# Webhook signing secret (Admin Center -> Apps and integrations -> Webhooks).
# Without this every webhook is rejected: an unset secret would otherwise mean
# an unauthenticated public endpoint.
ZENDESK_WEBHOOK_SECRET=

# Slack Incoming Webhook for resolution summaries. Blank disables them;
# Slack is optional and its absence is never an error.
SLACK_WEBHOOK_URL=

# Zendesk App shared secret, for verifying signed sidebar requests.
# Blank rejects every sidebar request; an unset secret must never mean
# "no authentication required".
ZENDESK_APP_SECRET=
ZENDESK_APP_ISSUER=
